/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/run/numberOfThreads 128
/run/initialize
/output/print false

#Folder
/output/folder noPhysics1m

#Detector, 801x801 for astropix
/detector/nCols_blocks 101
/detector/nRows_blocks 101
/detector/nCols_detector 101
/detector/nRows_detector 101

#/detector/nBlocks 4
#/detector/nBlocksTracking 2
#/detector/dz 0.25
#/detector/CarbonThickness 0.2
/run/reinitializeGeometry

#Paritcle Position
#/randGun/randPAngle
#/randGun/randPos

#ZDC energy smearing, sigma/E = sqrt((a/sqrt(E[GeV]))^2 + b^2)
#/zdc/resStochastic 0.30
#/zdc/resConstant 0

#NP and AP scaling
/CE/NPCrossSectionFactor 1
/CE/APScale 1

#Polarization
/Polarization/PPValue 0.7

#Physics
/process/inactivate Electromagnetic
/process/inactivate Hadronic
/process/inactivate Decay
/process/activate neutronChargeExNP

/run/printProgress 100000
/run/beamOn 1000000
