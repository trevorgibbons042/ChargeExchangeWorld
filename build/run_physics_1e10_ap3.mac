/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/run/numberOfThreads 8
/run/initialize
/output/print false

#ZDC energy smearing, sigma/E = sqrt((a/sqrt(E[GeV]))^2 + b^2), 0 and 0 = off
/zdc/resStochastic 0.50
/zdc/resConstant 0.045

#Detector, 801x801 for astropix
/detector/nCols_blocks 101
/detector/nRows_blocks 101
/detector/nCols_detector 101
/detector/nRows_detector 101

#/detector/nBlocks 4
#/detector/nBlocksTracking 2
#/detector/dz 0.25
#/detector/CarbonThickness 0.2

/run/reinitializeGeometry

#Paritcle Position
#/randGun/randPAngle
#/randGun/randPos

#Folder
/output/folder Physics1e10AP3

#Stacking (kill gamma/e+-/mu+-/neutrino secondaries, true = faster)
/stack/killExtras true
#Production cut (no secondaries with range below this)
#/run/setCut 0.7 mm

#Polarization
/Polarization/PPValue 0.7

#CE NP cross section factor, 1 = regular value
/CE/NPCrossSectionFactor 1e10
#AP scale, 1 = regular value, AP is clamped to -1.0 at the low end
/CE/APScale 3

/run/printProgress 100000
/run/beamOn 100000
