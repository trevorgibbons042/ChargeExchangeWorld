/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/run/numberOfThreads 128
/run/initialize
/output/print false

#Folder
/output/folder newPhysics_801_100m

#Detector, 801x801 for astropix
/detector/nCols_blocks 801
/detector/nRows_blocks 801
/detector/nCols_detector 801
/detector/nRows_detector 801

#/detector/nBlocks 4
#/detector/nBlocksTracking 2
#/detector/dz 0.25
#/detector/CarbonThickness 0.2
/run/reinitializeGeometry

#Paritcle Position
/randGun/randPAngle 1
/randGun/randPos 1

#Beam neutron kinetic energy and its Gaussian sigma, both in GeV
#Setups: 25 with 0.92, 50 with 1.8, 137.5 with 5
/randGun/Energy 25
/randGun/EnergySD 0.92

#ZDC energy smearing, sigma/E = sqrt((a/sqrt(E[GeV]))^2 + b^2)
#/zdc/resStochastic 0.30
#/zdc/resConstant 0

#Polarization
/Polarization/PPValue 0.7
#/Polarization/PPSigma 0

#NP and AP scaling
#/CE/NPCrossSectionFactor 1
#/CE/APScale 1

#Turn off the neutron quark exchange (charge exchange) inside FTF, neutronChargeExNP stays on
#Stacking (kill gamma/e+-/mu+-/neutrino) and Production cut (no secondaries with range below this)
/CE/noFTFNeutronCE true
/stack/killExtras false
#/run/setCut 0.7 mm

/run/printProgress 100000
/run/beamOn 100000000
