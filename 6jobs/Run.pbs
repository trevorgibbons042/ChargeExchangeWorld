#!/bin/bash -l
#PBS -q backfill
#PBS -A eic
#PBS -N Run

#PBS -l select=1:ncpus=128
#PBS -l walltime=12:00:00
#PBS -j oe

#PBS -m bea
#PBS -M tgibbons@anl.gov

cd /lcrc/project/eic/tgibbons/G4ChargeExchange/build/

module load root
export LD_LIBRARY_PATH=/lcrc/project/eic/tgibbons/xxhash-install/lib:$LD_LIBRARY_PATH

echo Jobid: $PBS_JOBID
echo Running on host `hostname`
echo Running on nodes `cat $PBS_NODEFILE`

# the macro comes from Run.sh (qsub -v MAC=<file in build/>); run_0.mac when submitted by hand
MAC=${MAC:-run_0.mac}
echo Macro: $MAC
export G4FORCENUMBEROFTHREADS=128 # every macro runs on all 128 cpus of the node, whatever its /run/numberOfThreads says
./sim $MAC