#!/bin/bash -l
#PBS -N dphi_test
#PBS -q backfill
#PBS -A eic
#PBS -l select=1:ncpus=32
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /lcrc/project/eic/tgibbons/G4ChargeExchange/6jobs/dphi_test.log
module load root
export LD_LIBRARY_PATH=/lcrc/project/eic/tgibbons/xxhash-install/lib:/lcrc/project/eic/tgibbons/gif-lib:$LD_LIBRARY_PATH
export NCPUS=32 ANA_NTHREADS=32 ACLIC=+O PLOT_PIPELINE=1
B=/lcrc/project/eic/tgibbons/G4ChargeExchange
D=$B/build/root/bgrej_test
cd $D
rsync -a $B/6jobs/run_lib.sh $D/
cp $B/6jobs/F9_dphi_test.cpp $D/F9_PlotReconNew.cpp
zsh -c "source ./run_lib.sh; run F9_PlotReconNew.cpp" 2>&1 | grep -av TCanvas
ls plots/6_ReconNew_1/6_megaCut/2_phi_cosfit
echo ALLDONE
