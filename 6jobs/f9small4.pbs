#!/bin/bash -l
#PBS -q backfill
#PBS -A eic
#PBS -N F9Small4
#PBS -l select=1:ncpus=32
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /lcrc/project/eic/tgibbons/f9small4.log
module load root
export LD_LIBRARY_PATH=/lcrc/project/eic/tgibbons/xxhash-install/lib:/lcrc/project/eic/tgibbons/gif-lib:$LD_LIBRARY_PATH
export NCPUS=32 ANA_NTHREADS=32 ACLIC=+O PLOT_PIPELINE=1
cd /lcrc/project/eic/tgibbons/f9small
cp ../F9dbg.cpp F9_PlotReconNew.cpp
rm -f F9_PlotReconNew_cpp.*
zsh -c "source ./run_lib.sh; run F9_PlotReconNew.cpp" 2>&1 | grep -av TCanvas | grep -av TCanvas | grep -a -A25 "Break" | cut -c1-220 | head -80
