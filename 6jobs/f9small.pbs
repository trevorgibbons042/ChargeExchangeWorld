#!/bin/bash -l
#PBS -q backfill
#PBS -A eic
#PBS -N F9Small
#PBS -l select=1:ncpus=32
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -o /lcrc/project/eic/tgibbons/f9small.log
module load root
export LD_LIBRARY_PATH=/lcrc/project/eic/tgibbons/xxhash-install/lib:/lcrc/project/eic/tgibbons/gif-lib:$LD_LIBRARY_PATH
export NCPUS=32 ANA_NTHREADS=32 ACLIC=+O PLOT_PIPELINE=1
B=/lcrc/project/eic/tgibbons/G4ChargeExchange
S=$B/build/root/newPhysics_801_100m_0.1m/50GeV/1block
T=/lcrc/project/eic/tgibbons/f9small; rm -rf $T; mkdir -p $T/cuts; cd $T
cp $S/settings.csv .
rsync -a --exclude __pycache__ --exclude "*_cpp.*" --exclude .DS_Store --exclude CLAUDE.md --exclude debug $B/5rootMacros/ $T/
rsync -a $B/6jobs/run_lib.sh $T/
root -l -b -q -e "TFile* f=TFile::Open(\"$S/cuts/cut_angles_all.root\"); TFile o(\"cuts/cut_angles_all.root\",\"recreate\"); TTree* t=((TTree*)f->Get(\"AnglesRaw\"))->CloneTree(3000000); t->Write(); o.Close();"
zsh -c "source ./run_lib.sh; run F9_PlotReconNew.cpp" 2>&1 | grep -av TCanvas | tail -40
