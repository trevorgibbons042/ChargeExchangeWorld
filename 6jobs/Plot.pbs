#!/bin/bash -l
#PBS -q backfill
#PBS -A eic
#PBS -N Plot

#PBS -l select=1:ncpus=128
#PBS -l walltime=12:00:00
#PBS -j oe

# One step of the analysis chain (5rootMacros/run.sh) or one lane of the plotting chain (5rootMacros/plot.sh) for one run folder, submitted by SubmitEvents.sh or SubmitPlots.sh
# with -v RUN=<folder in build/root>,STEP=<step name>,NCPUS=<threads>[,PARTS=<Plot3D parts joined with +>].
# The macros run from the run folder's own copy (the Submit scripts copy them in), so the ACLiC libraries of parallel jobs do not collide.
# BASE can be overridden to try the step list on another machine.
BASE=${BASE:-/lcrc/project/eic/tgibbons/G4ChargeExchange}

cd $BASE/build/root/$RUN || exit 1

module load root
export LD_LIBRARY_PATH=/lcrc/project/eic/tgibbons/xxhash-install/lib:$LD_LIBRARY_PATH
export ACLIC=${ACLIC-+O} # compiled with ACLiC. The macros and headers hold no global with a runtime initializer, which made ROOT 6.32 fail to load a compiled macro (runStaticInitializersOnce, 5rootMacros/CLAUDE.md). Submit with -v ACLIC= to run interpreted.

export ANA_NTHREADS=${NCPUS:-128} PLOT_PIPELINE=1 # threads for NThreads() (FitCore.h); the macros skip BoxAndCropPlots, the pdfs step runs the python scripts

echo Jobid: $PBS_JOBID
echo Running on host `hostname`
echo Run folder: $RUN, step: $STEP

# The same lanes as plot.sh: a lane holds the macros that write into the same plots/ folders or read another's csv files
case $STEP in
    cutevents) macros=('CutEvents.cpp') ;; # SubmitEvents.sh: the analysis chain of run.sh
    analysis) macros=('CutEvents.cpp' 'ReconAngleAll.cpp' 'CalcAPandT.cpp' 'CountCE.cpp' 'CutPlots.cpp') ;; # SubmitEvents.sh: the five analysis steps in one job, one after the other, all the cores each
    analysisconvert) macros=('CutEvents.cpp' 'ConvertAngles.cpp' 'CalcAPandT.cpp' 'CountCE.cpp' 'CutPlots.cpp') ;; # the same with ConvertAngles.cpp instead of the refit (cutdone)
    analysis6) macros=('CutEvents.cpp' 'ReconAngleAll.cpp' 'CalcAPandT.cpp("true")' 'CutPlots.cpp') ;; # Submit6Cuts.sh: only what plots/6_cuts reads: no CountCE, CalcAPandT true KE only, CutPlots without the trees part
    cutplots6) macros=('CutPlots.cpp') ;; # Submit6Cuts.sh CutPlots: the same CutPlots, for a run whose recon is done
    recon)    macros=('ReconAngleAll.cpp') ;;
    convert) macros=('ConvertAngles.cpp') ;; # the cut_angles_all.root of an old ReconAngleAll.cpp into the one-tree format, no refit
    calc)     macros=('CalcAPandT.cpp') ;; # true KE, then detector KE
    countce)  macros=('CountCE.cpp') ;;
    cuttrees) macros=('CutPlots.cpp') ;; # the KE cut lists, cut_ZdcCE.root and cut_ZdcAllEv.root, and one cut file per cut of 6_cuts, all read by the plot lanes
    cuts)     macros=('Plot3D.cpp' 'QualityStudy.cpp') ;; # 1_position, 2_energy, 6_cuts; Plot3D runs its four parts as four processes (below)
    plot3d)   macros=('Plot3D.cpp') ;; # SubmitPlots.sh redo of one folder: only the Plot3D parts in PARTS (e.g. 2:1+3:1+4:1), part 5 when one is a part 2
    quality)  macros=('QualityStudy.cpp') ;; # the same, after plot3d
    fom)      macros=('PlotAngle.cpp("fDEnergy")' 'PlotCEFraction.cpp' 'PlotPolarization.cpp("fDEnergy")' 'PlotFomPolarization.cpp("fDEnergy")') ;; # 3_ReconCalcVals, 5_fomCalc
    ceblock)  macros=('PlotDiffPhiCuts.cpp(50, 180, "fDEnergy")' 'GraphBlocks.cpp' 'CETCompare.cpp') ;; # 4_CEblock
    secce)    macros=('SecondaryCE.cpp') ;; # 7_secondaryCE
    smear)    macros=('SmearMatrix.cpp') ;; # 8_smear
    pdfs)     macros=() ;; # the python steps of plot.sh, after every lane
    *) echo "unknown step $STEP"; exit 1 ;;
esac

# Build every macro of the step once, before the parallel processes (CutPlots, Plot3D): two processes never build the same .so (as in plot.sh)
if [ -n "$ACLIC" ]; then
    for m in "${macros[@]}"; do root -l -b -q -e ".L ${m%%(*}$ACLIC" > /dev/null 2>&1 & done # one process per macro, side by side: each macro builds its own .so
    wait
fi
# The analysis steps also build the macros of the plot jobs that run after them (Plot3D alone took 78 s of the Cuts job), beside the analysis: ReconAngleAll waits on the disk and leaves
# most of the cores idle. The plot jobs then find the .so files up to date. Waited for before the job ends, the plot jobs start after it.
precompile=
case $STEP in
    analysis|analysisconvert)
        if [ -n "$ACLIC" ]; then
            ( for m in Plot3D QualityStudy PlotKEOverlay PlotAngle PlotCEFraction PlotPolarization PlotFomPolarization PlotDiffPhiCuts GraphBlocks CETCompare SecondaryCE SmearMatrix; do nice -n 10 root -l -b -q -e ".L $m.cpp$ACLIC" > /dev/null 2>&1 & done; wait ) &
            precompile=$!
        fi ;;
esac

for m in "${macros[@]}"; do
    echo "=== $m $(date +%H:%M:%S)"
    if [ "$m" = CutPlots.cpp ] && [ -z "$CUT_ONLY" ]; then
        # trees, zdc and the sample files without a ZDC KE cut side by side, then the sample files that read cut_ZdcAllEv.root (megacut2, megacut3, the KE scan 85 90 95, hitZDC) as five processes (CUT_ONLY, CutPlots.cpp)
        nc=${NCPUS:-128}
        t_trees=$(( nc / 32 > 0 ? nc / 32 : 1 )); t_half=$(( nc / 2 > 0 ? nc / 2 : 1 )); t_five=$(( nc / 5 > 0 ? nc / 5 : 1 ))
        cp_run(){ # name threads part CUT_ONLY
            ( ANA_NTHREADS=$2 CUT_ONLY=$4 root -l -b -q "${m/.cpp/.cpp${ACLIC-+O}}(\"$3\")" > CutPlots_$1.log 2>&1; echo "CutPlots $1 exit $?" ) &
        }
        case $STEP in analysis6|cutplots6) ;; *) cp_run trees $t_trees trees "" ;; esac # the KE cut lists feed the Fom lane only, not 6_cuts
        cp_run zdc $t_half zdc ""
        cp_run samplesA $t_half samples "ResCuts,nParticles,nZdc1,nHits,nChHits,cut_megacut_"
        wait
        cp_run samplesB1 $t_five samples "cut_megacut2_1.root,cut_hitZDC"
        cp_run samplesB2 $t_five samples "cut_megacut3_1.root"
        cp_run samplesB3 $t_five samples "_ke85"
        cp_run samplesB4 $t_five samples "_ke90"
        cp_run samplesB5 $t_five samples "_ke95"
        wait
        tail -n 4 CutPlots_*.log
        continue
    fi
    if [ "$m" = Plot3D.cpp ]; then
        # the independent parts of Plot3D (P3_PART, P3_CUT, Plot3D.cpp) side by side, one process each: part 1, and parts 2, 3 and 4 once per cut (0 to 10; part 4 also 11 to 16, the KE scan sets of 7_megaCut2 and 9_megaCut3; parts 3 and 4 of cut 0 once per folder, 0:0 to 0:3, P3_SUB), then part 5 ranks the cuts. One process per cut keeps part 3 (the 1_additionalinfo plots) from running all cuts one after the other
        # the cores are split evenly over the processes (128 cpus: 46 processes of 2 threads), part 5 and QualityStudy then take all of them
        # PARTS (joined with +) picks some of them, for SubmitPlots.sh redoing one folder
        parts=(1::0 1::1 1::2 1::3 3:0:0 3:0:1:0 3:0:1:1 3:0:1:2 3:0:1:3 3:0:1:4 3:0:1:5 3:0:2 3:0:3:0 3:0:3:1 3:0:3:2 3:0:3:3 3:1 3:2 3:3 3:4 3:5 3:6 3:7 3:8 3:9 3:10 4:5 4:6 4:8 4:11 4:12 4:13 4:14 4:15 4:16 2:0 2:1 2:2 2:3 2:4 2:5 2:6 2:7 2:8 2:9 2:10)
        [ -n "$PARTS" ] && parts=(${PARTS//+/ })
        # threads per process (all of PARTS unset), from the walls of the 137.5 GeV 9block run at 2 threads: a process of w s gets about 2w/300 threads, so each should land near 5 minutes. The table adds up to 82 of 128 (part 2 writes csv rows only and runs on the default 1 thread: 2:0 used 48% of one core) and thr_for doubles it (OVERSUB), so the cores of finished parts go to the parts still running; the phi scans of 6/7/9_megaCut (4:5, 4:6, 4:8: 4 threads) and their KE scans (4:11 to 4:16: 2) the new weights, not timed yet; a part not listed gets 1
        thr_for(){
            local t
            case "$1" in
                3:0:1:[0-3]) t=3 ;; 3:0:1:[45]) t=2 ;; 3:0:0|3:0:2) t=4 ;; 3:0:3:[0-3]) t=2 ;; 3:1) t=2 ;;
                1::0) t=3 ;; 1::[123]) t=4 ;; 4:[568]) t=4 ;; 4:1[1-6]) t=2 ;; *) t=1 ;;
            esac
            t=$(( t * ${OVERSUB:-2} )) # OVERSUB=1 gives the plain table
            echo $(( t * ${NCPUS:-128} / 128 > 0 ? t * ${NCPUS:-128} / 128 : 1 ))
        }
        export ANA_NTHREADS=$(( ${NCPUS:-128} / ${#parts[@]} > 0 ? ${NCPUS:-128} / ${#parts[@]} : 1 )) # PARTS set (a redo): the cores split evenly
        ANA_NTHREADS=${NCPUS:-128} P3_PART=0 P3_CUT= P3_SUB= root -l -b -q "${m/.cpp/.cpp${ACLIC-+O}}" > Plot3D_part0.log 2>&1 # cuts/plot3d_totals.csv, once with all the threads (Plot3D.cpp RawTotals)
        for run in "${parts[@]}"; do
            ( cut=; sub=; sec=; [[ $run == *:* ]] && cut=${run#*:}; [[ $cut == *:* ]] && { sub=${cut#*:}; cut=${cut%%:*}; }; [[ $sub == *:* ]] && { sec=${sub#*:}; sub=${sub%%:*}; }; [ -z "$PARTS" ] && export ANA_NTHREADS=$(thr_for "$run"); P3_PART=${run%%:*} P3_CUT=$cut P3_SUB=$sub P3_SEC=$sec root -l -b -q "${m/.cpp/.cpp${ACLIC-+O}}" > Plot3D_part${run//:/_}.log 2>&1; echo "part $run exit $?" ) &
        done
        wait
        export ANA_NTHREADS=${NCPUS:-128}
        if [ -z "$PARTS" ] || [[ $PARTS == *2:* ]]; then # the rank csv files, from the rows of the part 2 processes (cuts/rank_rows_<i>.tsv, the ones of the cuts not redone stay)
            P3_PART=5 P3_CUT= root -l -b -q "${m/.cpp/.cpp${ACLIC-+O}}" > Plot3D_part5.log 2>&1
        fi
        if [ -z "$PARTS" ] || [[ $PARTS == *4:* ]]; then # the KE overlays of the megaCut folders (6_cuts/<megaCut>/KE_overlay), from the csv files of part 4, before tidy_plots.py moves them
            root -l -b -q "PlotKEOverlay.cpp${ACLIC-+O}" > PlotKEOverlay.log 2>&1
        fi
        tail -n 3 Plot3D_part*.log
        continue
    fi
    time root -l -b -q "${m/.cpp/.cpp${ACLIC-+O}}" # compiled with ACLiC (+O) unless ACLIC= (empty)
done
[ -n "$precompile" ] && wait $precompile # the plot macros built beside the analysis

if [ "$STEP" = pdfs ]; then
    python3 tidy_plots.py plots
    python3 cut_side_box.py plots
    python3 crop_pdfs.py plots
fi
mkdir -p plots; cp settings.csv plots/ # the sim settings of this run beside its plots, after every step (a run without the pdfs step has them too)
