#!/bin/bash -l
#PBS -q backfill
#PBS -A eic
#PBS -N Plot

#PBS -l select=1:ncpus=128
#PBS -l walltime=12:00:00
#PBS -j oe

# One step of the analysis chain (6jobs/run_all.sh) or one lane of the plotting chain (6jobs/plot.sh) for one run folder, submitted by SubmitEvents.sh or SubmitPlots.sh
# with -v RUN=<folder in build/root>,STEP=<step name>,NCPUS=<threads>.
# The macros run from the run folder's own copy (the Submit scripts copy them in), so the ACLiC libraries of parallel jobs do not collide.
# BASE can be overridden to try the step list on another machine.
BASE=${BASE:-/lcrc/project/eic/tgibbons/G4ChargeExchange}

cd $BASE/build/root/$RUN || exit 1
mkdir -p cuts plots # a fresh run folder from the sim has neither; run_all.sh makes them for the local chain

module load root
export LD_LIBRARY_PATH=/lcrc/project/eic/tgibbons/xxhash-install/lib:$LD_LIBRARY_PATH
export ACLIC=${ACLIC-+O} # compiled with ACLiC. The macros and headers hold no global with a runtime initializer, which made ROOT 6.32 fail to load a compiled macro (runStaticInitializersOnce, 5rootMacros/CLAUDE.md). Submit with -v ACLIC= to run interpreted.

export ANA_NTHREADS=${NCPUS:-128} PLOT_PIPELINE=1 # threads for NThreads() (FitCore.h); the macros skip BoxAndCropPlots, the pdfs step runs the python scripts

echo Jobid: $PBS_JOBID
echo Running on host `hostname`
echo Run folder: $RUN, step: $STEP

# The same lanes as plot.sh: a lane holds the macros that write into the same plots/ folders or read another's csv files
case $STEP in
    cutevents) macros=('CutPlots.cpp("events")') ;; # SubmitEvents.sh: the analysis chain of run_all.sh
    analysis) macros=('CutPlots.cpp("events")' 'ReconAngleAll.cpp' 'CalcAPandT.cpp' 'CutPlots.cpp("count")') ;; # SubmitEvents.sh: the four analysis steps in one job, one after the other, all the cores each (F1_2_Plot3D.cpp reads AnglesRaw itself, CutPlots zdc writes nothing)
    recon)    macros=('ReconAngleAll.cpp') ;; # the event recon (cuts/cut_angles_all.root, needs TrackerHitsAll from the sim)
    reconnew) macros=('CutPlots.cpp("events")' 'ReconAngleAll.cpp' 'F9_PlotReconNew.cpp') ;; # only plots/6_ReconNew_1: CutPlots events first (cut_CE.root, which PlotReconNew opens), then the event recon (cuts/cut_angles_all.root), then its plots; nothing else of the chain
    plotnew)  macros=('F9_PlotReconNew.cpp' 'F10_BDTCuts.cpp') ;; # only the plots of plots/6_ReconNew_1, cuts/cut_angles_all.root is there from reconnew
    calc)     macros=('CalcAPandT.cpp') ;; # the detector KE trees of cut_APandT.root
    countce)  macros=('CutPlots.cpp("count")') ;;
    plot3d)   macros=('F1_2_Plot3D.cpp') ;; # 1_position, 2_energy; Plot3D runs its three groups as three processes (below)
    ceblock)  macros=('F4_CEBlock.cpp(50, 180, "fDEnergy")') ;; # 4_CEblock
    calcplots) macros=('F3_ReconCalcVals.cpp("fDEnergy")' 'F5_FomCalc.cpp') ;; # 3_ReconCalcVals (needs cut_APandT.root) and 5_fomCalc (needs cut_angles_all.root)
    secce)    macros=('F7_SecondaryCE.cpp' 'F9_PlotReconNew.cpp') ;; # 7_secondaryCE, and 6_ReconNew_1 (the event recon of ReconAngleAll.cpp, a folder of its own)
    pdfs)     macros=() ;; # the python steps of plot.sh, after every lane
    *) echo "unknown step $STEP"; exit 1 ;;
esac

# Build every macro of the step once, before the parallel processes (Plot3D): two processes never build the same .so (as in plot.sh)
if [ -n "$ACLIC" ]; then
    for m in $(printf '%s\n' "${macros[@]%%(*}" | sort -u); do root -l -b -q -e ".L $m$ACLIC" > /dev/null 2>&1 & done # each macro once # one process per macro, side by side: each macro builds its own .so
    wait
fi
# The analysis steps also build the macros of the plot jobs that run after them (Plot3D took 78 s), beside the analysis: ReconAngleAll waits on the disk and leaves
# most of the cores idle. The plot jobs then find the .so files up to date. Waited for before the job ends, the plot jobs start after it.
precompile=
case $STEP in
    analysis)
        if [ -n "$ACLIC" ]; then
            ( for m in F1_2_Plot3D F4_CEBlock F7_SecondaryCE F9_PlotReconNew; do nice -n 10 root -l -b -q -e ".L $m.cpp$ACLIC" > /dev/null 2>&1 & done; wait ) &
            precompile=$!
        fi ;;
esac

for m in "${macros[@]}"; do
    echo "=== $m $(date +%H:%M:%S)"
    if [ "$m" = F1_2_Plot3D.cpp ]; then
        # the three groups of Plot3D (P3_SUB 0 to 2: 1_position/1_true, 1_position/2_block, 2_energy) side by side, one process each, a third of the cores each
        export ANA_NTHREADS=$(( ${NCPUS:-128} / 3 > 0 ? ${NCPUS:-128} / 3 : 1 ))
        for sub in 0 1 2; do P3_SUB=$sub root -l -b -q "${m/.cpp/.cpp${ACLIC-+O}}" > Plot3D_sub$sub.log 2>&1 & done
        wait
        tail -n 3 Plot3D_sub*.log
        export ANA_NTHREADS=${NCPUS:-128}
        continue
    fi
    time root -l -b -q "${m/.cpp/.cpp${ACLIC-+O}}" # compiled with ACLiC (+O) unless ACLIC= (empty)
done
[ -n "$precompile" ] && wait $precompile # the plot macros built beside the analysis


if [ "$STEP" = pdfs ]; then
    python3 python/tidy_plots.py plots
    python3 python/crop_pdfs.py plots
fi
mkdir -p plots; cp settings.csv plots/ # the sim settings of this run beside its plots, after every step (a run without the pdfs step has them too)
